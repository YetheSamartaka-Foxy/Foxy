{
  "id": "state-delta-clean-check-ssd",
  "kind": "perf",
  "description": "Repair deterministic PBO mutations with delta transfers, independently verify the repaired bytes, then assert a clean check performs no hashing or tree verification.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 600,
  "origin": {
    "root": "${RUN_DIR}/origin",
    "port": 18134,
    "synthetic": [
      { "root": "${RUN_DIR}/origin", "seed": 20261051, "mods": 1, "files_per_mod": 4, "file_bytes": 1048576, "pbo_entries": 64, "entry_bytes": 16384 }
    ]
  },
  "repository": {
    "name": "RepoAlpha",
    "address": "http://127.0.0.1:18134/",
    "path": "${RUN_DIR}/repo-alpha",
    "space_id": null
  },
  "operations": [
    { "op": "download", "label": "seed-download", "setup_once": true, "wait_timeout_s": 120 },
    { "op": "mutate", "profile": "scattered", "seed": 42, "files": 2, "entries": 4 },
    {
      "op": "download",
      "label": "delta-repair",
      "wait_timeout_s": 120,
      "expect": [
        { "path": "summary.patched_files", "min": 1 },
        { "path": "summary.delta_savings_percent", "min": 0.01 },
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 }
      ]
    },
    {
      "op": "quick-check",
      "label": "clean-check",
      "wait_timeout_s": 120,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "breakdown.run_metrics.hash_work_bytes", "equals": 0 },
        { "path": "breakdown.run_metrics.tree_verify_runs", "equals": 0 }
      ]
    }
  ],
  "repetitions": 1,
  "warmup": false,
  "guards": {
    "require_storage_class": "ssd",
    "require_no_other_foxy": true,
    "require_clean_worktree": false,
    "fail_on_db_wipe": true,
    "max_run_gb": 1,
    "oracle_command": [
      "${REPO_ROOT}/target/release/foxy-testkit-oracle.exe",
      "--repository-path", "${REPOSITORY_PATH}"
    ]
  }
}

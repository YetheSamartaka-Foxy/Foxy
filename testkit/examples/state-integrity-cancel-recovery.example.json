{
  "id": "state-integrity-cancel-recovery-ssd",
  "kind": "perf",
  "description": "Cancel an explicit integrity pass, preserve installed bytes, then complete the integrity check and verify the following quick check reuses its evidence.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 600,
  "settings": { "cpu_thread_limit": 1, "hash_io_profile": "Conservative" },
  "origin": {
    "root": "${RUN_DIR}/origin",
    "port": 18147,
    "synthetic": [
      { "root": "${RUN_DIR}/origin", "seed": 20261072, "repo_name": "RepoAlpha", "mods": 1, "files_per_mod": 64, "file_bytes": 33554432, "pbo_entries": 512, "entry_bytes": 65536 }
    ]
  },
  "repository": {
    "name": "RepoAlpha",
    "address": "http://127.0.0.1:18147/",
    "path": "${RUN_DIR}/repo-alpha",
    "space_id": null
  },
  "operations": [
    { "op": "download", "setup_once": true, "wait_timeout_s": 180 },
    { "op": "capture-file-state", "setup_once": true, "label": "installed" },
    {
      "op": "recheck-integrity",
      "label": "cancel-integrity",
      "cancel_after_hash_progress": 0.2,
      "wait_timeout_s": 300,
      "expect_outcome": "cancelled",
      "expect": [
        { "path": "summary.cancel_trigger_hash_progress", "min": 0.2, "max": 0.99 }
      ]
    },
    { "op": "assert-file-state", "label": "installed", "comparison": "equal" },
    {
      "op": "recheck-integrity",
      "label": "complete-integrity-recovery",
      "wait_timeout_s": 240,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "breakdown.run_metrics.hash_work_bytes", "min": 1 }
      ]
    },
    { "op": "assert-file-state", "label": "installed", "comparison": "equal" },
    {
      "op": "quick-check",
      "label": "quick-check-after-integrity-recovery",
      "keep_hash_record": true,
      "wait_timeout_s": 120,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "breakdown.run_metrics.hash_work_bytes", "equals": 0 }
      ]
    }
  ],
  "repetitions": 1,
  "warmup": false,
  "guards": {
    "require_storage_class": "ssd",
    "require_no_other_foxy": true,
    "require_clean_worktree": false,
    "fail_on_db_wipe": true,
    "max_run_gb": 4,
    "oracle_command": ["${REPO_ROOT}/target/release/foxy-testkit-oracle.exe", "--repository-path", "${REPOSITORY_PATH}"]
  }
}

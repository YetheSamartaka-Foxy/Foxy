{
  "id": "state-independent-copy-refresh-ssd",
  "kind": "perf",
  "description": "Install the same URL in two run-local folders, drift and refresh one copy, then prove only that repository instance queues and repairs files.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 600,
  "origin": {
    "root": "${RUN_DIR}/origin",
    "port": 18148,
    "synthetic": [
      { "root": "${RUN_DIR}/origin", "seed": 20261073, "repo_name": "RepoAlpha", "mods": 1, "files_per_mod": 2, "file_bytes": 1048576, "pbo_entries": 64, "entry_bytes": 16384 }
    ]
  },
  "repository": {
    "name": "RepoAlpha",
    "address": "http://127.0.0.1:18148/",
    "path": "${RUN_DIR}/repo-alpha",
    "space_id": null
  },
  "extra_repositories": [
    {
      "name": "RepoBeta",
      "address": "http://127.0.0.1:18148/",
      "path": "${RUN_DIR}/repo-beta",
      "space_id": null
    }
  ],
  "operations": [
    { "op": "download", "setup_once": true, "wait_timeout_s": 180 },
    { "op": "download", "setup_once": true, "repository": "RepoBeta", "wait_timeout_s": 180 },
    { "op": "capture-file-state", "setup_once": true, "label": "repo-beta", "path": "${RUN_DIR}/repo-beta" },
    { "op": "capture-file-state", "setup_once": true, "label": "repo-alpha", "path": "${RUN_DIR}/repo-alpha" },
    {
      "op": "mutate",
      "profile": "single-entry",
      "seed": 20261074,
      "path": "${RUN_DIR}/repo-alpha",
      "targets": ["@synthetic_000/addons/part_00000.pbo"]
    },
    {
      "op": "remote-refresh",
      "repository": "RepoAlpha",
      "label": "refresh-first-copy",
      "wait_timeout_s": 180,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 }
      ]
    },
    { "op": "assert-pending-update-count", "repository": "RepoAlpha", "minimum": 1, "maximum": 1, "addons": ["@synthetic_000"] },
    { "op": "assert-pending-update-count", "repository": "RepoBeta", "minimum": 0, "maximum": 0 },
    { "op": "assert-file-state", "label": "repo-alpha", "path": "${RUN_DIR}/repo-alpha", "comparison": "different" },
    { "op": "assert-file-state", "label": "repo-beta", "path": "${RUN_DIR}/repo-beta", "comparison": "equal" },
    {
      "op": "download",
      "repository": "RepoAlpha",
      "label": "repair-first-copy",
      "wait_timeout_s": 180,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "summary.files_updated", "min": 1 }
      ]
    },
    { "op": "assert-file-state", "label": "repo-beta", "path": "${RUN_DIR}/repo-beta", "comparison": "equal" },
    { "op": "assert-pending-update-count", "repository": "RepoBeta", "minimum": 0, "maximum": 0 }
  ],
  "repetitions": 1,
  "warmup": false,
  "guards": {
    "require_storage_class": "ssd",
    "require_no_other_foxy": true,
    "require_clean_worktree": false,
    "fail_on_db_wipe": true,
    "max_run_gb": 1,
    "oracle_command": ["${REPO_ROOT}/target/release/foxy-testkit-oracle.exe", "--repository-path", "${REPOSITORY_PATH}"]
  }
}

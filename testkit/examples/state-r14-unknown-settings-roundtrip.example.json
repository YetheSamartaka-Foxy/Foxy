{
  "id": "state-r14-unknown-settings-roundtrip",
  "kind": "perf",
  "description": "Seed valid split app and game settings with unknown nested fields, save a known setting through the running UI, restart, and verify every saved value remains.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 180,
  "origin": {
    "root": "${RUN_DIR}/origin",
    "port": 18171,
    "synthetic": [
      { "root": "${RUN_DIR}/origin", "seed": 20261014, "mods": 1, "files_per_mod": 1, "file_bytes": 1024, "repo_name": "RepoAlpha" }
    ]
  },
  "repository": { "name": "RepoAlpha", "address": "http://127.0.0.1:18171/", "path": "${RUN_DIR}/repo-alpha", "space_id": null },
  "settings": { "auto_recheck_on_launch": false, "auto_quick_scan_on_launch": false },
  "config_files": {
    "app_settings.json": {
      "auto_recheck_on_launch": false,
      "auto_quick_scan_on_launch": false,
      "swifty_migration_offered": true,
      "show_fps_counter": false,
      "future_app_setting": { "marker": "app-future-value", "revision": 14 }
    },
    "games/arma3/game_settings.json": {
      "apply_repo_json_client_parameters": true,
      "future_game_setting": { "marker": "game-future-value", "revision": 14 }
    }
  },
  "operations": [
    { "op": "ui-set-setting", "setup_once": true, "key": "show-fps-counter", "value": "true" },
    {
      "op": "wait-for-config-json", "setup_once": true, "wait_timeout_s": 30,
      "path": "${RUN_DIR}/config/app_settings.json", "json_path": "show_fps_counter", "equals": true
    },
    { "op": "startup", "label": "restart-after-ui-save", "wait_timeout_s": 90 },
    { "op": "assert-config-json", "path": "${RUN_DIR}/config/app_settings.json", "json_path": "show_fps_counter", "equals": true },
    { "op": "assert-config-json", "path": "${RUN_DIR}/config/app_settings.json", "json_path": "future_app_setting.marker", "equals": "app-future-value" },
    { "op": "assert-config-json", "path": "${RUN_DIR}/config/games/arma3/game_settings.json", "json_path": "apply_repo_json_client_parameters", "equals": true },
    { "op": "assert-config-json", "path": "${RUN_DIR}/config/games/arma3/game_settings.json", "json_path": "future_game_setting.marker", "equals": "game-future-value" }
  ],
  "repetitions": 1,
  "warmup": false,
  "guards": { "require_storage_class": "ssd", "require_no_other_foxy": true, "require_clean_worktree": false, "fail_on_db_wipe": true, "max_run_gb": 1 }
}

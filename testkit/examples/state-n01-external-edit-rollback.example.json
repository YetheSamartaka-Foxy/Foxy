{
  "id": "state-n01-external-edit-rollback-ssd",
  "kind": "perf",
  "description": "Edit a promoted managed file during a synthetic update, then cancel and verify rollback restores the captured pre-update bytes.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 600,
  "origin": {
    "root": "${RUN_DIR}/origin-v1",
    "port": 18148,
    "delay_ms": 600,
    "synthetic": [
      { "root": "${RUN_DIR}/origin-v1", "seed": 20261081, "mods": 1, "files_per_mod": 8, "file_bytes": 1048576 },
      { "root": "${RUN_DIR}/origin-v2", "seed": 20261082, "mods": 1, "files_per_mod": 8, "file_bytes": 1048576 }
    ]
  },
  "repository": {
    "name": "RepoAlpha",
    "address": "http://127.0.0.1:18148/",
    "path": "${RUN_DIR}/repo-alpha",
    "space_id": null
  },
  "operations": [
    { "op": "download", "label": "seed-download", "setup_once": true, "wait_timeout_s": 180 },
    { "op": "capture-file-state", "label": "baseline", "setup_once": true },
    { "op": "origin-switch", "root": "${RUN_DIR}/origin-v2" },
    { "op": "remote-refresh", "wait_timeout_s": 180 },
    {
      "op": "download",
      "label": "external-edit-then-cancel",
      "cancel_after_promoted_file": true,
      "external_edit_after_promoted_file": "external edit during managed update",
      "wait_timeout_s": 180,
      "expect_outcome": "cancelled"
    },
    { "op": "assert-file-state", "label": "baseline", "comparison": "equal" }
  ],
  "repetitions": 1,
  "warmup": false,
  "settings": { "memory_pressure_override": "Severe" },
  "guards": {
    "require_storage_class": "ssd",
    "require_no_other_foxy": true,
    "require_clean_worktree": false,
    "fail_on_db_wipe": true,
    "max_run_gb": 1,
    "oracle_command": [
      "${REPO_ROOT}\\target\\release\\foxy-testkit-oracle.exe",
      "--repository-path",
      "${REPOSITORY_PATH}"
    ]
  }
}

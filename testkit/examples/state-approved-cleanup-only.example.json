{
  "id": "state-approved-cleanup-only-ssd",
  "kind": "perf",
  "description": "Detect one unmanifested file during a clean published-content refresh, preserve it through review, then remove it only when the user starts Update.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 600,
  "origin": {
    "root": "${RUN_DIR}/origin",
    "port": 18149,
    "synthetic": [
      { "root": "${RUN_DIR}/origin", "seed": 20261075, "repo_name": "RepoAlpha", "mods": 1, "files_per_mod": 2, "file_bytes": 1048576 }
    ]
  },
  "repository": {
    "name": "RepoAlpha",
    "address": "http://127.0.0.1:18149/",
    "path": "${RUN_DIR}/repo-alpha",
    "space_id": null
  },
  "operations": [
    { "op": "download", "setup_once": true, "wait_timeout_s": 180 },
    { "op": "capture-file-state", "setup_once": true, "label": "published-content" },
    {
      "op": "write-file",
      "setup_once": true,
      "path": "${RUN_DIR}/repo-alpha/@synthetic_000/personal-experiment.cfg",
      "content": "remove this only after Update is approved\n"
    },
    { "op": "capture-file-state", "setup_once": true, "label": "with-extra" },
    {
      "op": "remote-refresh",
      "label": "cleanup-preview",
      "wait_timeout_s": 180,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 }
      ]
    },
    { "op": "assert-pending-update-count", "minimum": 1, "maximum": 1, "addons": ["@synthetic_000"] },
    { "op": "assert-file-exists", "path": "${RUN_DIR}/repo-alpha/@synthetic_000/personal-experiment.cfg" },
    { "op": "assert-file-state", "label": "with-extra", "comparison": "equal" },
    {
      "op": "recheck-integrity",
      "label": "check-does-not-clean-extra",
      "wait_timeout_s": 180,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "breakdown.run_metrics.hash_work_bytes", "min": 1 }
      ]
    },
    { "op": "assert-file-exists", "path": "${RUN_DIR}/repo-alpha/@synthetic_000/personal-experiment.cfg" },
    { "op": "assert-file-state", "label": "with-extra", "comparison": "equal" },
    {
      "op": "download",
      "label": "approved-cleanup-only-update",
      "inspect_cleanup": true,
      "wait_timeout_s": 180,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "summary.files_updated", "equals": 0 },
        { "path": "summary.cleanup.residual_files", "equals": 0 }
      ]
    },
    { "op": "assert-file-absent", "path": "${RUN_DIR}/repo-alpha/@synthetic_000/personal-experiment.cfg" },
    { "op": "assert-file-state", "label": "published-content", "comparison": "contains" },
    { "op": "assert-pending-update-count", "minimum": 0, "maximum": 0 }
  ],
  "repetitions": 1,
  "warmup": false,
  "guards": {
    "require_storage_class": "ssd",
    "require_no_other_foxy": true,
    "require_clean_worktree": false,
    "fail_on_db_wipe": true,
    "max_run_gb": 1,
    "oracle_command": ["${REPO_ROOT}/target/release/foxy-testkit-oracle.exe", "--repository-path", "${REPOSITORY_PATH}"]
  }
}

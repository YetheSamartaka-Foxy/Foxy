{
  "id": "state-recovery-ssd",
  "kind": "perf",
  "description": "Seed a synthetic update, verify cooperative cancellation and normal close restore the old bytes, then kill after a promoted file and verify restart keeps the forward state before the update finishes.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 600,
  "origin": {
    "root": "${RUN_DIR}/origin-v1",
    "port": 18131,
    "delay_ms": 600,
    "synthetic": [
      { "root": "${RUN_DIR}/origin-v1", "seed": 20261001, "mods": 1, "files_per_mod": 8, "file_bytes": 1048576 },
      { "root": "${RUN_DIR}/origin-v2", "seed": 20261002, "mods": 1, "files_per_mod": 8, "file_bytes": 1048576 }
    ]
  },
  "repository": {
    "name": "RepoAlpha",
    "address": "http://127.0.0.1:18131/",
    "path": "${RUN_DIR}/repo-alpha",
    "space_id": null
  },
  "operations": [
    { "op": "download", "label": "seed-download", "setup_once": true, "wait_timeout_s": 180 },
    { "op": "capture-file-state", "label": "baseline", "setup_once": true },
    { "op": "origin-switch", "root": "${RUN_DIR}/origin-v2" },
    { "op": "remote-refresh", "wait_timeout_s": 180 },
    {
      "op": "download",
      "label": "cancel-after-promotion",
      "cancel_after_promoted_file": true,
      "wait_timeout_s": 180,
      "expect_outcome": "cancelled"
    },
    { "op": "assert-file-state", "label": "baseline", "comparison": "equal" },
    {
      "op": "download",
      "label": "close-after-promotion",
      "close_after_promoted_file": true,
      "wait_timeout_s": 180,
      "expect_outcome": "cancelled"
    },
    { "op": "assert-file-state", "label": "baseline", "comparison": "equal" },
    {
      "op": "download",
      "label": "kill-after-promotion",
      "kill_after_promoted_file": true,
      "wait_timeout_s": 180
    },
    { "op": "assert-file-state", "label": "baseline", "comparison": "different" },
    { "op": "capture-file-state", "label": "crash-state" },
    { "op": "startup", "label": "recover-after-kill", "wait_timeout_s": 180 },
    { "op": "assert-file-state", "label": "crash-state", "comparison": "contains" },
    { "op": "assert-file-state", "label": "baseline", "comparison": "different" },
    {
      "op": "download",
      "label": "resume-after-crash",
      "wait_timeout_s": 180,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 }
      ]
    }
  ],
  "repetitions": 1,
  "warmup": false,
  "settings": { "memory_pressure_override": "Severe" },
  "guards": {
    "require_storage_class": "ssd",
    "require_no_other_foxy": true,
    "require_clean_worktree": false,
    "fail_on_db_wipe": true,
    "max_run_gb": 1,
    "oracle_command": [
      "${REPO_ROOT}\\target\\release\\foxy-testkit-oracle.exe",
      "--repository-path",
      "${REPOSITORY_PATH}"
    ]
  }
}

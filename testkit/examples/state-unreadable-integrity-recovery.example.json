{
  "id": "state-unreadable-integrity-recovery-ssd",
  "kind": "perf",
  "description": "Deny shared access to one installed file, require an incomplete unreadable integrity result without changing files or authorizing an update, then verify recovery after the lock is released.",
  "build": "release",
  "harness": "gui",
  "timeout_s": 600,
  "origin": {
    "root": "${RUN_DIR}/origin",
    "port": 18150,
    "synthetic": [
      { "root": "${RUN_DIR}/origin", "seed": 20261076, "repo_name": "RepoAlpha", "mods": 1, "files_per_mod": 2, "file_bytes": 4194304 }
    ]
  },
  "repository": {
    "name": "RepoAlpha",
    "address": "http://127.0.0.1:18150/",
    "path": "${RUN_DIR}/repo-alpha",
    "space_id": null
  },
  "operations": [
    { "op": "download", "setup_once": true, "wait_timeout_s": 180 },
    { "op": "capture-file-state", "setup_once": true, "label": "installed" },
    { "op": "assert-pending-update-count", "setup_once": true, "minimum": 0, "maximum": 0 },
    {
      "op": "acquire-test-file-lock",
      "setup_once": true,
      "path": "${RUN_DIR}/repo-alpha/@synthetic_000/addons/part_00000.bin"
    },
    {
      "op": "recheck-integrity",
      "label": "locked-file-is-unreadable",
      "wait_timeout_s": 240,
      "expect_outcome": "incomplete-integrity",
      "expect": [
        { "path": "progress.hash_evidence_issue_counts.unreadable", "equals": 1 },
        { "path": "progress.hash_evidence_issue_counts.missing", "equals": 0 },
        { "path": "breakdown.run_metrics.hash_work_bytes", "min": 4194304 }
      ]
    },
    {
      "op": "release-test-file-lock",
      "path": "${RUN_DIR}/repo-alpha/@synthetic_000/addons/part_00000.bin"
    },
    { "op": "assert-file-state", "label": "installed", "comparison": "equal" },
    { "op": "assert-pending-update-count", "minimum": 0, "maximum": 0 },
    {
      "op": "recheck-integrity",
      "label": "full-integrity-after-unlock",
      "wait_timeout_s": 240,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "breakdown.run_metrics.hash_work_bytes", "min": 8388608 },
        { "path": "progress.hash_evidence_issue_counts.unreadable", "equals": 0 },
        { "path": "progress.hash_evidence_issue_counts.missing", "equals": 0 }
      ]
    },
    { "op": "assert-file-state", "label": "installed", "comparison": "equal" },
    {
      "op": "quick-check",
      "label": "clean-check-after-integrity",
      "keep_hash_record": true,
      "wait_timeout_s": 120,
      "expect": [
        { "path": "breakdown.run_metrics.failed_pipelines", "equals": 0 },
        { "path": "breakdown.run_metrics.hash_work_bytes", "equals": 0 }
      ]
    }
  ],
  "repetitions": 1,
  "warmup": false,
  "guards": {
    "require_storage_class": "ssd",
    "require_no_other_foxy": true,
    "require_clean_worktree": false,
    "fail_on_db_wipe": true,
    "max_run_gb": 1,
    "oracle_command": ["${REPO_ROOT}/target/release/foxy-testkit-oracle.exe", "--repository-path", "${REPOSITORY_PATH}"]
  }
}
